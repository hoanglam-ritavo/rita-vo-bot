# Preserve package fingerprints and snapshot bytes on every platform.
/chunks/** -text -filter -ident -working-tree-encoding


# Preserve runtime fingerprints even when core.autocrlf is enabled.
/models/** -text -filter -ident -working-tree-encoding
/artifacts/** -text -filter -ident -working-tree-encoding
# Hydrate these files with Git LFS before verification or runtime startup.
/models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
/models/*.onnx filter=lfs diff=lfs merge=lfs -text
/models/**/sentencepiece.bpe.model filter=lfs diff=lfs merge=lfs -text
/models/**/tokenizer.json filter=lfs diff=lfs merge=lfs -text
