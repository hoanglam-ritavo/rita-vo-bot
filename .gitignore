# Local environments and credentials.
env/
.venv/
.env
.env.*
!.env.example
!.env.test.example

# Python bytecode and test caches at any depth.
__pycache__/
*.py[cod]
.pytest_cache/
/.tmp/
# Colab source belongs in collabs; generated/local data belongs in .tmp.
/collabs/intent-colab/dist/
/collabs/intent-colab/runs/
/collabs/intent-colab/models/
/collabs/intent-colab/verification-work/
/collabs/intent-colab/verification-env/
/collabs/intent-colab/verify-*/
/collabs/intent-colab/*.zip
/collabs/intent-colab/verification.json
/collabs/intent-colab/bundle-manifest.json
pytest-cache-files-*/

