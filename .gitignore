# Local environments and credentials.
env/
.venv/
.env
.env.*
!.env.example

# Python bytecode and test caches at any depth.
__pycache__/
*.py[cod]
.pytest_cache/
/.tmp/
pytest-cache-files-*/

# Local catalog and generated outputs; keep directory documentation.
/app/data/*
!/app/data/README.md

# Legacy output locations stay ignored to protect residual private files.
/data/*
!/data/README.md

# Ignore Windows thumbnail caches in assets.
/app/assets/**/[tT][hH][uU][mM][bB][sS].[dD][bB]

# Keep video source files out of assets (including nested paths).
/app/assets/**/*.[mM][pP]4
/app/assets/**/*.[mM][kK][vV]
/app/assets/**/*.[mM][oO][vV]
/app/assets/**/*.[aA][vV][iI]
/app/assets/**/*.[wW][mM][vV]
/app/assets/**/*.[wW][eE][bB][mM]
/app/assets/**/*.[mM]4[vV]
/app/assets/**/*.[mM][pP][eE][gG]
/app/assets/**/*.[mM][pP][gG]
/app/assets/**/*.[fF][lL][vV]
/app/assets/**/*.[tT][sS]
/app/assets/**/*.[mM][tT][sS]
/app/assets/**/*.[mM]2[tT][sS]
/app/assets/**/*.3[gG][pP]

# Historical indexing workspaces remain private.
/indexing_workspace/
/indexing_chunks/
# Track only current package artifacts; exclude old layouts and temporary files.
/app/chunks/*
!/app/chunks/*/
/app/chunks/*/*
!/app/chunks/*/metadata.json
!/app/chunks/*/extraction.json
!/app/chunks/*/chunks.json
!/app/chunks/*/source.pdf
!/app/chunks/*/source.txt
!/app/chunks/*/source.md
!/app/chunks/*/source.csv
!/app/chunks/*/source.xlsx
!/app/chunks/*/source.doc
!/app/chunks/*/source.docx
/app/chunks/.*/
/app/chunks/review/
/app/chunks/approved/
