# Local catalog and generated outputs; keep directory documentation.
/app/data/*
!/app/data/README.md

# Legacy output locations stay ignored to protect residual private files.
/app/assets/
/app/chunks/
/data/*
!/data/README.md

# Ignore Windows thumbnail caches in assets.
/assets/**/[tT][hH][uU][mM][bB][sS].[dD][bB]

# Keep video source files out of assets (including nested paths).
/assets/**/*.[mM][pP]4
/assets/**/*.[mM][kK][vV]
/assets/**/*.[mM][oO][vV]
/assets/**/*.[aA][vV][iI]
/assets/**/*.[wW][mM][vV]
/assets/**/*.[wW][eE][bB][mM]
/assets/**/*.[mM]4[vV]
/assets/**/*.[mM][pP][eE][gG]
/assets/**/*.[mM][pP][gG]
/assets/**/*.[fF][lL][vV]
/assets/**/*.[tT][sS]
/assets/**/*.[mM][tT][sS]
/assets/**/*.[mM]2[tT][sS]
/assets/**/*.3[gG][pP]

# Historical indexing workspaces remain private.
/indexing_workspace/
/indexing_chunks/
# Track only current package artifacts; exclude old layouts and temporary files.
/chunks/*
!/chunks/*/
/chunks/*/*
!/chunks/*/metadata.json
!/chunks/*/extraction.json
!/chunks/*/chunks.json
!/chunks/*/source.pdf
!/chunks/*/source.txt
!/chunks/*/source.md
!/chunks/*/source.csv
!/chunks/*/source.xlsx
!/chunks/*/source.doc
!/chunks/*/source.docx
/chunks/.*/
/chunks/review/
/chunks/approved/
