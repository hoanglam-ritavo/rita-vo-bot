# Pytest reference only. Pass selected variables through the pytest process environment.
# Each suite needs its own disposable database. Use direct PostgreSQL URLs and private credentials.

# Corpus, retrieval and publication: pgvector and migration privileges required.
# TEST_DATABASE_URL=postgresql+psycopg://corpus_test_user:replace_me@localhost:5432/rita_corpus_test

# Conversations: permission to create and drop the suite's test schema.
# TEST_CONVERSATION_DATABASE_URL=postgresql+psycopg://chat_test_user:replace_me@localhost:5432/rita_chat_test

# HRM: preprovisioned synthetic data with SELECT, UPDATE and DELETE on the fixture table.
# TEST_HRM_DATABASE_URL=postgresql+psycopg://hrm_test_user:replace_me@localhost:5432/rita_hrm_test
# TEST_HRM_DATABASE_SCHEMA=public
# Set only after verifying the fixture is disposable and separate from runtime HRM.
# TEST_HRM_DISPOSABLE_CONFIRMED=true
