class Failure(ValueError):
    """Fixed safe error; never include question text or a dependency traceback."""


def require(condition, code):
    if not condition:
        raise Failure(code)


def reject_links(path):
    absolute = Path(os.path.abspath(path))
    for component in (*reversed(absolute.parents), absolute):
        try:
            info = component.lstat()
        except FileNotFoundError:
            continue
        require(not stat.S_ISLNK(info.st_mode) and not (
            getattr(info, 'st_file_attributes', 0)
            & getattr(stat, 'FILE_ATTRIBUTE_REPARSE_POINT', 0x400)), 'link_path_rejected')


def private_path(value):
    path = Path(value)
    reject_links(path)
    path = path.resolve()
    root = (Path.cwd() / '.tmp').resolve()
    require(path != root and path.is_relative_to(root), 'intent_path_outside_tmp')
    return path


def read_dataset(path):
    return json.loads(private_path(path).read_text(encoding='utf-8'))


def atomic_json(path, data):
    temporary = path.with_name('.' + path.name + '.' + uuid.uuid4().hex + '.tmp')
    try:
        with temporary.open('x', encoding='utf-8') as stream:
            json.dump(data, stream, ensure_ascii=False, indent=2, allow_nan=False)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def file_hash(path):
    reject_links(path)
    with path.open('rb') as stream:
        before = os.fstat(stream.fileno())
        result = hashlib.file_digest(stream, 'sha256').hexdigest()
        after = os.fstat(stream.fileno())
    require((before.st_size, before.st_mtime_ns) == (after.st_size, after.st_mtime_ns),
            'input_changed_during_read')
    return result


def model_fingerprint(path):
    reject_links(path)
    require(path.is_dir(), 'local_model_missing')
    files, queue = {}, [path]
    while queue:
        for item in sorted(queue.pop().iterdir()):
            reject_links(item)
            if item.is_dir():
                queue.append(item)
            elif item.is_file():
                files[item.relative_to(path).as_posix()] = file_hash(item)
            else:
                raise Failure('nonregular_model_file')
    require(bool(files), 'local_model_empty')
    return digest(files)


def normalize_question(question):
    require(isinstance(question, str) and bool(question.strip()), 'invalid_question')
    question = question.strip()
    require(len(question) <= 8000, 'question_too_long')
    # Original rerank variant only: no typo-corrected variant is used for intent.
    return ' '.join(unicodedata.normalize('NFC', question).split())


def load_training_dependencies():
    # Called only after validation and (for train) human-review checks.
    global np, sklearn, LogisticRegression, ConvergenceWarning
    global f1_score, confusion_matrix, precision_score, StratifiedGroupKFold
    import numpy as np
    import sklearn
    from sklearn.linear_model import LogisticRegression
    from sklearn.exceptions import ConvergenceWarning
    from sklearn.metrics import f1_score, confusion_matrix, precision_score
    from sklearn.model_selection import StratifiedGroupKFold
    return {name: version(name) for name in ('numpy', 'scikit-learn', 'torch', 'sentence-transformers')}


class Encoder:
    def __init__(self, model_path, revision, device, batch_size):
        reject_links(model_path)
        self.path = Path(model_path).resolve()
        self.revision, self.device, self.batch_size = revision.lower(), device, batch_size
        self.model = None

    def load(self):
        import torch
        require(self.device != 'cuda' or torch.cuda.is_available(), 'cuda_unavailable')
        if self.device == 'cuda':
            torch.backends.cuda.matmul.allow_tf32 = False
            torch.backends.cudnn.allow_tf32 = False
        from sentence_transformers import SentenceTransformer
        self.fingerprint = model_fingerprint(self.path)
        self.model = SentenceTransformer(str(self.path), device=self.device,
                                        local_files_only=True, trust_remote_code=False)
        self.model.float().eval()
        require(self.model.get_sentence_embedding_dimension() == 384, 'model_dimensions')
        self.verify()

    @property
    def model_identity(self):
        return identity(self.revision, self.fingerprint, True)

    def verify(self):
        require(model_fingerprint(self.path) == self.fingerprint, 'model_changed')

    def preflight(self, cases):
        limit = min(self.model.max_seq_length, self.model.tokenizer.model_max_length)
        require(type(limit) is int and limit > 0, 'invalid_model_token_limit')
        checks = []
        for index, case in enumerate(cases):
            content = 'query: ' + normalize_question(case['question'])
            count = len(self.model.tokenizer(content, add_special_tokens=True,
                                             truncation=False)['input_ids'])
            checks.append({'case_index': index, 'token_count': count, 'limit': limit,
                           'status': 'passed' if count <= limit else 'exceeded'})
        return {'status': 'passed' if all(c['status'] == 'passed' for c in checks) else 'failed',
                'identity': self.model_identity, 'checks': checks}

    def _encode_texts(self, questions):
        inputs = ['query: ' + normalize_question(q) for q in questions]
        vectors = self.model.encode(inputs, batch_size=self.batch_size, precision='float32',
                                    normalize_embeddings=True, convert_to_numpy=True,
                                    show_progress_bar=False, device=self.device)
        require(vectors.shape == (len(inputs), 384) and np.isfinite(vectors).all(),
                'invalid_query_vector')
        # Match retrieval's post-encode Python float normalization exactly.
        result = []
        for vector in vectors:
            values = vector.tolist()
            norm = math.hypot(*values)
            require(math.isfinite(norm) and norm > 0, 'invalid_query_vector')
            result.append([v / norm for v in values])
        return np.asarray(result)

    def encode(self, cases):
        return self._encode_texts([c['question'] for c in cases])

    def numerical_comparison(self):
        if self.device != 'cuda':
            return {'status': 'not_run', 'reason': 'cpu_selected'}
        questions = ['Điều kiện nghỉ phép là gì?', 'Tôi đang thuộc phòng ban nào?', 'Xin chào!']
        gpu = self._encode_texts(questions)
        try:
            self.model.to('cpu')
            self.device = 'cpu'
            cpu = self._encode_texts(questions)
        finally:
            self.model.to('cuda')
            self.device = 'cuda'
        return {'status': 'measured', 'synthetic_cases': len(questions),
                'max_abs_difference': float(np.max(np.abs(gpu - cpu))),
                'minimum_cosine': float(np.min(np.sum(gpu * cpu, axis=1))),
                'bit_identical_required': False,
                'limitation': 'diagnostic_only_not_quality_or_runtime_acceptance'}

    def close(self):
        self.model = None
        if 'torch' in sys.modules and sys.modules['torch'].cuda.is_available():
            sys.modules['torch'].cuda.empty_cache()


def train_loaded(encoder, data):
    """Shared by batch CLI and legacy trainer; returns the existing artifact schema."""
    artifact, report = train(encoder.encode(data['cases']), data['cases'], encoder.model_identity)
    report['dataset_sha256'] = dataset_hash(data)
    report['candidate_payload_sha256'] = digest(artifact)
    artifact['acceptance'] = {'reviewed': True, 'dataset_sha256': dataset_hash(data),
                              'report_sha256': digest(report), 'gates': report['gates']}
    validate_artifact(artifact, artifact['identity'], require_accepted=False)
    return artifact, report


def timestamp():
    return datetime.now(timezone.utc).isoformat()


def progress(stage):
    print('intent_training stage=' + stage, file=sys.stderr, flush=True)


def execute(args):
    encoder = run_dir = manifest = None
    try:
        data = read_dataset(args.dataset)
        validation = inspect_dataset(data)
        if args.command == 'validate':
            return {'status': validation['status'], 'validation': validation}, 0 if not validation['errors'] else 1
        require(re.fullmatch('[0-9a-fA-F]{40}', args.model_revision) is not None, 'invalid_model_revision')
        require(args.batch_size > 0, 'invalid_batch_size')
        model_path = Path(args.model_path)
        reject_links(model_path)
        model_path = model_path.resolve()
        if args.command == 'train':
            root = private_path(args.output_root)
            dataset_path = private_path(args.dataset)
            require(not root.is_relative_to(model_path) and not dataset_path.is_relative_to(model_path),
                    'output_or_dataset_inside_model')
            require(not model_path.is_relative_to(root), 'model_inside_output')
            root.mkdir(parents=True, exist_ok=True)
            run_dir = root / (datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + uuid.uuid4().hex)
            run_dir.mkdir(exist_ok=False)
            manifest = {'schema_version': 1, 'tool_version': TOOL_VERSION, 'complete': False,
                        'status': 'running', 'started_at': timestamp(), 'outputs': {},
                        'dataset_sha256': dataset_hash(data), 'contract_snapshot': CONTRACT_SNAPSHOT,
                        'contract_snapshot_algorithm': CONTRACT_SNAPSHOT_ALGORITHM,
                        'script_sha256': file_hash(Path(__file__)),
                        'python': platform.python_version(), 'platform': platform.platform(),
                        'device': args.device, 'batch_size': args.batch_size,
                        'preprocessing': 'rerank_original'}
            atomic_json(run_dir / 'manifest.json', manifest)
            atomic_json(run_dir / 'validation.json', validation)
        if validation['errors']:
            result, code = {'status': 'validation_failed', 'validation': validation}, 1
        elif args.command == 'train' and not validation['training_allowed']:
            result, code = {'status': 'review_required', 'error_code': 'human_review_required'}, 2
        else:
            progress('model_preflight')
            # Silence dependency output that may include submitted inputs or local paths.
            with open(os.devnull, 'w') as sink, redirect_stdout(sink), redirect_stderr(sink):
                versions = load_training_dependencies()
                encoder = Encoder(model_path, args.model_revision, args.device, args.batch_size)
                encoder.load()
                preflight = encoder.preflight(data['cases'])
                preflight['numerical_comparison'] = (encoder.numerical_comparison()
                    if preflight['status'] == 'passed' else {'status': 'not_run', 'reason': 'token_failure'})
                encoder.verify()
            require(dataset_hash(read_dataset(args.dataset)) == dataset_hash(data), 'training_inputs_changed')
            preflight.update(dependencies=versions, review_required=validation['review_required'],
                             training_allowed=validation['training_allowed'] and preflight['status'] == 'passed')
            if run_dir:
                manifest.update(dependencies=versions, model_identity=encoder.model_identity)
                atomic_json(run_dir / 'preflight.json', preflight)
            if preflight['status'] != 'passed':
                result, code = {'status': 'preflight_failed', 'preflight': preflight}, 1
            elif args.command == 'preflight':
                result, code = {'status': 'preflight_passed', 'preflight': preflight}, 0
            else:
                progress('embedding_training_evaluation')
                with open(os.devnull, 'w') as sink, redirect_stdout(sink), redirect_stderr(sink):
                    artifact, report = train_loaded(encoder, data)
                    encoder.verify()
                require(dataset_hash(read_dataset(args.dataset)) == dataset_hash(data), 'training_inputs_changed')
                encoder.close()
                encoder = None
                atomic_json(run_dir / 'training-report.json', report)
                atomic_json(run_dir / 'candidate.json', artifact)
                manifest['outputs'] = {name: digest(value) for name, value in
                                       [('training-report.json', report), ('candidate.json', artifact)]}
                passed = all(v for k, v in report['gates'].items() if k != 'latency')
                result, code = {'status': 'candidate_ready_for_benchmark' if passed else 'quality_failed',
                                'gates': report['gates']}, 0 if passed else 1
        if encoder is not None:
            encoder.close()
            encoder = None
        if manifest:
            manifest.update(result, complete=result['status'] in ('candidate_ready_for_benchmark', 'quality_failed'),
                            finished_at=timestamp(), exit_code=code)
            atomic_json(run_dir / 'manifest.json', manifest)
            result['run_directory'] = str(run_dir)
        return result, code
    except (Exception, KeyboardInterrupt) as exc:
        interrupted = isinstance(exc, KeyboardInterrupt)
        safe_errors = {'training_fold_missing_class', 'human_review_required'}
        error_code = ('interrupted' if interrupted else str(exc) if isinstance(exc, Failure)
                      or (isinstance(exc, ValueError) and str(exc) in safe_errors) else 'intent_training_failed')
        if isinstance(exc, ImportError):
            error_code = 'dependency_unavailable'
        if 'torch' in sys.modules and isinstance(exc, sys.modules['torch'].OutOfMemoryError):
            error_code = 'out_of_memory_reduce_batch_size'
        result = {'status': 'interrupted' if interrupted else 'failed', 'error_code': error_code}
        code = 130 if interrupted else 2
        if manifest:
            result['run_directory'] = str(run_dir)
            manifest.update(result, complete=False, finished_at=timestamp(), exit_code=code)
            try:
                atomic_json(run_dir / 'manifest.json', manifest)
            except OSError:
                result['manifest_update_failed'] = True
        return result, code
    finally:
        if encoder is not None:
            try:
                encoder.close()
            except Exception:
                pass


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    for name in ('validate', 'preflight', 'train'):
        command = commands.add_parser(name)
        command.add_argument('--dataset', required=True)
        if name != 'validate':
            command.add_argument('--model-path', required=True)
            command.add_argument('--model-revision', required=True)
            command.add_argument('--device', choices=('cuda', 'cpu'), default='cuda')
            command.add_argument('--batch-size', type=int, default=16)
        if name == 'train':
            command.add_argument('--output-root', required=True)
    args = parser.parse_args(argv)
    result, code = execute(args)
    print(json.dumps(result, ensure_ascii=True, allow_nan=False))
    return code


if __name__ == '__main__':
    raise SystemExit(main())
