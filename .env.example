# Local configuration. Never commit .env or real credentials.
# Process environment variables take precedence over .env; restart services after changes.
# API/gRPC entrypoints load .env explicitly; retrieval CLI uses explicit model/rerank flags.

# --- Database ---
# Required PostgreSQL URL (postgresql+psycopg://); keep credentials private.
# URL-encode credentials: synthetic abc@123 becomes abc%40123. Keep @ before the host.
# Quoting does not replace URL-encoding; this applies to all database URLs below.
DATABASE_URL=postgresql+psycopg://app_user:replace_me@localhost:5432/rita_bot

# Optional migration account; defaults to DATABASE_URL. Migrations are explicit.
# MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:replace_me@localhost:5432/rita_bot

# Optional dedicated disposable database only; integration tests migrate and write data.
# Never use the application or production database.
# TEST_DATABASE_URL=postgresql+psycopg://test_user:replace_me@localhost:5432/rita_bot_test

# --- Local gRPC health server ---
# Health checking only, without TLS/authentication. Only 127.0.0.1 is supported.
GRPC_HOST=127.0.0.1

# Listening port; default 50051, integer 1-65535.
GRPC_PORT=50051

# Shutdown grace in seconds; default 5, finite and non-negative.
GRPC_SHUTDOWN_GRACE_SECONDS=5

# --- Local retrieval HTTP API ---
# Returns document excerpts, not generated answers; Ollama is not required.
# Only 127.0.0.1 is supported; no authentication is provided.
API_HOST=127.0.0.1

# Listening port; default 8000, integer 1-65535.
API_PORT=8000

# --- Local E5 embedding model ---
# Full 40-hex model commit; must match local E5 files and indexed publication identity.
E5_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3

# Existing local E5 directory; relative paths resolve from the repository root.
# Loaded on CPU at API startup; no runtime model downloads.
E5_MODEL_PATH=.tmp/models/multilingual-e5-small/614241f622f53c4eeff9890bdc4f31cfecc418b3

# --- Retrieval output ---
# Maximum accepted excerpts; default 5, integer 1-20. Request top_k overrides this.
# Filtering may return fewer or zero excerpts; this is not a completeness guarantee.
RETRIEVAL_TOP_K=5

# --- Optional CPU reranking ---
# true/false; default false. Opt in only after quality and CPU latency gates pass.
# Public retrieval needs enabled reranking AND a matching calibrated profile to return candidates.
# Disabled reranking with candidates returns relevance_unavailable, not vector-only matches.
RERANK_ENABLED=false

# Existing pinned ONNX model and tokenizer directory; default models.
# Relative paths resolve from the repository root; no runtime downloads.
# Provision artifacts as described in docs/online-reranking.md.
RERANK_MODEL_PATH=models

# Only this pinned AVX2 ONNX filename is supported; artifacts are hash-validated.
RERANK_MODEL_FILE=model_quint8_avx2.onnx

# Fixed at 30 candidates, independent of requested top_k; not a tuning range.
RERANK_CANDIDATE_COUNT=30

# Windows per inference batch; default 4, integer 1-16.
# Changing this value changes the pipeline fingerprint and requires a matching profile.
RERANK_BATCH_SIZE=4

# Optional to start, required to accept candidates: existing validated schema-v2 profile.
# Must pass holdout and match model/pipeline AND eligible publication corpus fingerprints.
# Setting a path does not create or validate a profile; relative paths use the repository root.
# Missing/legacy/mismatched profiles withhold candidates with relevance_unavailable.
# Malformed configured profiles fail startup when reranking is enabled.
# See docs/online-reranking.md for calibration and rollout gates.
# RERANK_PROFILE_PATH=.tmp/evaluation/relevance-profile.json

# --- Optional intent observation ---
# off/observe; default off. Observation only: no routing or response changes.
INTENT_MODE=off

# For observe: provision an accepted, compatible local JSON artifact separately.
# Relative paths resolve from the repository root. Missing/incompatible artifacts leave retrieval available.
# See docs/intent-classifier.md; this artifact does not replace the relevance profile.
# INTENT_ARTIFACT_PATH=.tmp/intent/accepted-artifact.json
