DATABASE_URL=postgresql+psycopg://app_user:replace_me@localhost:5432/rita_bot
# URL-encode credentials: synthetic password abc@123 is written as abc%40123.
# Keep the @ before the host. Quoting the URL does not replace URL-encoding.
# This applies to DATABASE_URL, MIGRATION_DATABASE_URL and TEST_DATABASE_URL.
# Optional migration account; defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:replace_me@localhost:5432/rita_bot
# Dedicated disposable database only. Integration tests write data here.
# TEST_DATABASE_URL=postgresql+psycopg://test_user:replace_me@localhost:5432/rita_bot_test

# Local-only gRPC server (health checking only; no TLS or authentication).
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
GRPC_SHUTDOWN_GRACE_SECONDS=5
