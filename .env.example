# Local configuration. Never commit .env or real credentials.
# HTTP API: .env values override process environment, including database URLs.
# Missing keys use process environment, then defaults; restart the API after changes.
# Standalone database/CLI entrypoints retain their existing precedence.
# API entrypoint loads .env explicitly; retrieval CLI uses explicit model/rerank flags.

# --- Database ---
# Required PostgreSQL URL (postgresql+psycopg://); keep credentials private.
# URL-encode credentials: synthetic abc@123 becomes abc%40123. Keep @ before the host.
# Quoting does not replace URL-encoding; this applies to all database URLs below.
DATABASE_URL=postgresql+psycopg://app_user:replace_me@localhost:5432/rita_bot

# Optional migration account; defaults to DATABASE_URL. Migrations are explicit.
# MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:replace_me@localhost:5432/rita_bot

# Optional dedicated disposable database only; integration tests migrate and write data.
# Never use the application or production database.
# TEST_DATABASE_URL=postgresql+psycopg://test_user:replace_me@localhost:5432/rita_bot_test

# --- Optional readonly HRM source (not connected to answering/retrieval) ---
# Dedicated SELECT-only non-owner role; never use an application/migration writer.
# No fallback to DATABASE_URL. Provision permissions externally; see docs/employee-source.md.
# HRM_DATABASE_URL=postgresql+psycopg://hrm_reader:replace_me@localhost:5432/hrm
# HRM_DATABASE_SCHEMA=public
# Tests require a separately preprovisioned disposable fixture and readonly login.
# TEST_HRM_DATABASE_URL=postgresql+psycopg://hrm_test_reader:replace_me@localhost:5432/hrm_disposable
# TEST_HRM_DATABASE_SCHEMA=public
# TEST_HRM_DISPOSABLE_CONFIRMED=true

# --- Local retrieval HTTP API ---
# Returns document excerpts, not generated answers; Ollama is not required.
# Only 127.0.0.1 is supported; no authentication is provided.
API_HOST=127.0.0.1

# Listening port; default 8000, integer 1-65535.
API_PORT=8000

# --- Local E5 embedding model ---
# Full 40-hex model commit; must match local E5 files and indexed publication identity.
E5_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3

# Existing local E5 directory; relative paths resolve from the repository root.
# Loaded on CPU at API startup; no runtime model downloads.
E5_MODEL_PATH=models/embeddings/multilingual-e5-small/614241f622f53c4eeff9890bdc4f31cfecc418b3

# --- Retrieval output ---
# Maximum returned excerpts; default 5, integer 1-20. Request top_k overrides this.
# Filtering may return fewer or zero excerpts; this is not a completeness guarantee.
RETRIEVAL_TOP_K=5

# HTTP API only; true/false (case-insensitive), default true. Invalid values fail startup.
# false returns unassessed top-k candidates without loading a relevance profile.
# Reranking remains independently controlled below; eligibility/access filters always apply.
# HTTP startup gives this file precedence over process environment; restart after changes.
# CLI and offline benchmarks keep filtering enabled; this is not calibration acceptance.
RELEVANCE_FILTER_ENABLED=true

# --- Optional CPU reranking ---
# true/false; default false. Opt in only after quality and CPU latency gates pass.
# With relevance filtering enabled, returning candidates requires reranking AND a matching profile.
# With filtering disabled, return reranked candidates if enabled, vector candidates otherwise.
RERANK_ENABLED=false

# Existing pinned ONNX model and tokenizer directory; default models.
# Relative paths resolve from the repository root; no runtime downloads.
# Provision artifacts as described in docs/online-reranking.md.
RERANK_MODEL_PATH=models

# Only this pinned AVX2 ONNX filename is supported; artifacts are hash-validated.
RERANK_MODEL_FILE=model_quint8_avx2.onnx

# Fixed at 30 candidates, independent of requested top_k; not a tuning range.
RERANK_CANDIDATE_COUNT=30

# Windows per inference batch; default 4, integer 1-16.
# Changing this value changes the pipeline fingerprint and requires a matching profile.
RERANK_BATCH_SIZE=4

# Optional to start, required to accept candidates when relevance filtering is enabled.
# Must pass holdout and match model/pipeline AND eligible publication corpus fingerprints.
# Setting a path does not create or validate a profile; relative paths use the repository root.
# Missing/legacy/mismatched profiles withhold candidates with relevance_unavailable.
# Malformed configured profiles fail startup when both reranking and filtering are enabled.
# When filtering is disabled the profile file is ignored, including missing or malformed files.
# See docs/online-reranking.md for calibration and rollout gates.
# RERANK_PROFILE_PATH=artifacts/rerank/relevance-profile.json

# --- Optional corpus-bound Vietnamese expansion ---
# off/expand; default off. expand requires reranking and a reviewed matching lexicon.
# Semantic authoring is offline. Retrieval never calls a generative model.
# A separate semantic-pipeline relevance profile is required for filtered release.
SEMANTIC_MODE=off
# SEMANTIC_ARTIFACT_PATH=artifacts/semantics/lexicon.json

# --- Optional intent observation/assistance ---
# off/observe/assist; default off. observe retains result parity.
# assist requires semantic expand and a separately evaluated matching profile.
# Style hints prioritize valid alternatives only; no source routing or Type B calls.
INTENT_MODE=off

# For observe/assist: provision an accepted compatible local JSON artifact separately.
# Relative paths resolve from the repository root. Missing/incompatible artifacts leave retrieval available.
# See docs/intent-classifier.md; this artifact does not replace the relevance profile.
# INTENT_ARTIFACT_PATH=artifacts/intent/accepted-artifact.json

# --- Optional source-bound Semantic + template answers ---
# No generative model, model hash, native binding, study report or raw-output logging.
# Requires SEMANTIC_MODE=expand and the matching reviewed lexical artifact.
# Filtering still controls retrieval. Unfiltered responses remain unassessed.
ANSWER_ENABLED=false
ANSWER_CATALOG_PATH=artifacts/answers/catalog.json
# Retired ANSWER_MODEL_PATH/SHA256, ANSWER_REPORT_PATH/REVIEW_PATH and ANSWER_DEBUG_RAW are ignored.
# Retired ANSWER_PORT/ANSWER_RUNTIME_PATH/ANSWER_RUNTIME_SHA256 settings are ignored.
